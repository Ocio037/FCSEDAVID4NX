<Window x:Class="FocaCollisionEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foca Collision Editor" Height="760" Width="1180"
        MinHeight="560" MinWidth="860"
        Background="#FFFFFF"
        Foreground="#1F2937"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Padding" Value="5,4" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Background="#F3F4F6">
                <Button Content="Abrir .f3d" Click="OpenModel_Click" />
                <Separator />
                <Button Content="Añadir AABB" Click="AddAabb_Click" />
                <Button Content="Añadir OBB" Click="AddObb_Click" />
                <Button Content="Eliminar" Click="DeleteCollision_Click" />
                <Separator />
                <Button Content="Abrir / importar .fcol" Click="ImportFcol_Click" />
                <Button Content="Exportar .fcol" Click="ExportFcol_Click" />
                <Button Content="Guardar .fcol" Click="SaveCollisions_Click" />
                <Separator />
                <TextBlock x:Name="ModelNameText" VerticalAlignment="Center" Foreground="#374151" Text="Sin modelo 3D" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Background="#F3F4F6" Foreground="#374151">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Abre un .f3d o .fcol, o añade colisiones para comenzar." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Arrastra para orbitar · Botón derecho para mover · Rueda para acercar" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,10,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Image x:Name="ViewportImage" Stretch="Fill" />
                    <Canvas x:Name="OverlayCanvas" Background="Transparent"
                            SizeChanged="OverlayCanvas_SizeChanged"
                            MouseDown="OverlayCanvas_MouseDown"
                            MouseMove="OverlayCanvas_MouseMove"
                            MouseUp="OverlayCanvas_MouseUp"
                            MouseWheel="OverlayCanvas_MouseWheel" />
                    <TextBlock x:Name="EmptyViewText" Text="Abre un archivo .f3d o .fcol, o añade colisiones para empezar."
                               Foreground="#475569" FontSize="16" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="30" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Colisiones" Foreground="#111827" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="CollisionList" DockPanel.Dock="Top" Height="190" Margin="0,0,0,12"
                             SelectionChanged="CollisionList_SelectionChanged"
                             Background="#FFFFFF" Foreground="#1F2937" BorderBrush="#CBD5E1" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Propiedades" Foreground="#111827" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="ID" Foreground="#4B5563" />
                            <TextBox x:Name="IdTextBox" Margin="0,3,0,9" TextChanged="Inspector_TextChanged" />
                            <TextBlock Text="Forma" Foreground="#4B5563" />
                            <ComboBox x:Name="ShapeCombo" Margin="0,3,0,9" SelectionChanged="Inspector_SelectionChanged">
                                <ComboBoxItem Content="AABB" />
                                <ComboBoxItem Content="OBB" />
                            </ComboBox>
                            <TextBlock Text="Tipo" Foreground="#4B5563" />
                            <ComboBox x:Name="KindCombo" Margin="0,3,0,10" SelectionChanged="Inspector_SelectionChanged">
                                <ComboBoxItem Content="Sólida" />
                                <ComboBoxItem Content="Trigger" />
                            </ComboBox>

                            <TextBlock Text="Centro" Foreground="#374151" FontWeight="SemiBold" Margin="0,2,0,4" />
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CenterXTextBox" Grid.Column="0" Margin="0,0,3,0" ToolTip="Centro X" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="CenterYTextBox" Grid.Column="1" Margin="3,0" ToolTip="Centro Y" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="CenterZTextBox" Grid.Column="2" Margin="3,0,0,0" ToolTip="Centro Z" TextChanged="Inspector_TextChanged" />
                            </Grid>

                            <TextBlock Text="Tamaño" Foreground="#374151" FontWeight="SemiBold" Margin="0,2,0,4" />
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SizeXTextBox" Grid.Column="0" Margin="0,0,3,0" ToolTip="Tamaño X" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="SizeYTextBox" Grid.Column="1" Margin="3,0" ToolTip="Tamaño Y" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="SizeZTextBox" Grid.Column="2" Margin="3,0,0,0" ToolTip="Tamaño Z" TextChanged="Inspector_TextChanged" />
                            </Grid>

                            <TextBlock Text="Rotación (grados)" Foreground="#374151" FontWeight="SemiBold" Margin="0,2,0,4" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RotationXTextBox" Grid.Column="0" Margin="0,0,3,0" ToolTip="Rotación X" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="RotationYTextBox" Grid.Column="1" Margin="3,0" ToolTip="Rotación Y" TextChanged="Inspector_TextChanged" />
                                <TextBox x:Name="RotationZTextBox" Grid.Column="2" Margin="3,0,0,0" ToolTip="Rotación Z" TextChanged="Inspector_TextChanged" />
                            </Grid>
                            <TextBlock x:Name="InspectorHintText" Text="Selecciona una colisión para editarla." Foreground="#6B7280" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
