				$(SolutionDir)..\Lib\Time\include;
				$(SolutionDir)..\Lib\ohn\include;
				$(SolutionDir)..\FocaSys\FocaSys\include;
				$(SolutionDir)..\Lib\macros\include;
				$(SolutionDir)..\Lib\mem\include;
				$(SolutionDir)..\Lib\gx\include;
				$(SolutionDir)..\Lib\Font\include;
				C:\VulkanSDK\1.4.350.0\Include;
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
		</ClCompile>
	</ItemDefinitionGroup>
</Project>
